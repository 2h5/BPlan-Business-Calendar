# BPlan Web Client Environment Configuration
# Copy this file to .env.local for local development.
# Only public browser-safe variables prefixed with VITE_ may be included here.
# NEVER include server secrets, service-role keys, or OAuth client secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development

# Billing is disabled by default. Keep production checkout disabled until the
# seller identity and final Terms/Privacy documents have been approved.
VITE_BILLING_MODE=disabled
VITE_REVENUECAT_WEB_PURCHASE_URL=
VITE_REVENUECAT_BILLING_MANAGEMENT_URL=
VITE_BILLING_SELLER_IDENTITY_CONFIRMED=false
VITE_BILLING_LEGAL_DOCS_FINAL=false
VITE_BILLING_TERMS_URL=
VITE_BILLING_PRIVACY_URL=
