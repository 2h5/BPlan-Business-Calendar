{
  "name": "calendar-app",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "mobile": "pnpm --filter @cal/mobile start",
    "web": "pnpm --filter @cal/web dev",
    "ios": "pnpm --filter @cal/mobile ios",
    "android": "pnpm --filter @cal/mobile android",
    "build": "pnpm -r --if-present build && pnpm billing:build",
    "build:web": "pnpm --filter @cal/web build",
    "billing:build": "tsc -p tools/billing/tsconfig.cli.json",
    "billing:assert-user": "pnpm billing:build && node tools/billing/dist/assert-user-cli.js",
    "billing:checkout-ready": "pnpm billing:build && node tools/billing/dist/checkout-ready-cli.js",
    "billing:checkout-probe": "pnpm billing:build && node tools/billing/dist/checkout-probe-cli.js",
    "billing:e2e:sandbox": "pnpm billing:build && node tools/billing/dist/sandbox-purchase-cli.js",
    "billing:preflight": "pnpm billing:build && node tools/billing/dist/cli.js",
    "billing:test": "vitest run tools/billing/preflight.test.ts tools/billing/revenuecat-cli.test.ts tools/billing/assert-user.test.ts tools/billing/supabase-assertions.test.ts tools/billing/checkout-ready.test.ts tools/billing/checkout-probe.test.ts tools/billing/sandbox-purchase.test.ts",
    "billing:typecheck": "tsc --noEmit -p tools/billing/tsconfig.json",
    "typecheck": "pnpm -r --if-present typecheck && pnpm billing:typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test && pnpm billing:test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.types.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@revenuecat/cli": "0.1.1",
    "@supabase/supabase-js": "^2.45.4",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "playwright-core": "1.55.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2",
    "zod": "^3.23.8"
  }
}
